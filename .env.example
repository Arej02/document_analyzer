# Supabase project URL — Project Settings > API
SUPABASE_URL=

# Anon/public key — used by request-scoped (RLS-enforced) clients. Project Settings > API
SUPABASE_ANON_KEY=

# Service-role key — bypasses RLS, used only by the async worker. Never expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY=

# JWT secret used to validate incoming Supabase Auth tokens. Project Settings > API > JWT Settings
SUPABASE_JWT_SECRET=

# Direct Postgres connection string — used for pgmq (job queue) and Vault (GitHub
# token lifecycle) calls, which aren't exposed over PostgREST. Project Settings > Database
SUPABASE_DB_URL=

# Optional ingestion resource bounds — both have sane defaults (resource_bounds.py)
# and only need setting to override them.
# AGENT1_MAX_UPLOAD_SIZE_BYTES=524288000
# AGENT1_MAX_FILE_COUNT=50000

# Azure OpenAI — Phase 3 entity/module/subsystem/repo summarization (design.md
# §Bottom-up summarization). Unlike the pinned local embedding model, summary
# text does leave your infra per call — an accepted tradeoff for LLM quality.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_DEPLOYMENT=

# Optional: max concurrent in-flight entity-summary LLM calls (summarize_fanout.py).
# Sane default (10, per specs.md's "Decided" section) — only needs setting to override.
# AGENT1_SUMMARY_CONCURRENCY=10

# Optional: how many times an ungrounded summary is regenerated and re-checked before
# being flagged unverified (ground_retry.py). Sane default (2, per specs.md's "Decided"
# section) — only needs setting to override.
# AGENT1_GROUNDING_RETRY_CAP=2

# Agent 3 sandbox (design_agent3.md §7, §11). All optional, defaults shown.
# Build the runner image first: docker build -t galvanise-agent3-runner:0.1 backend/agent3_runner
# AGENT3_RUNNER_IMAGE=galvanise-agent3-runner:0.1
# AGENT3_SANDBOX_TIMEOUT_SECONDS=120
# AGENT3_SANDBOX_MEMORY_MB=1024
# Set to runsc to run under gVisor (Linux hosts only; not available on Docker Desktop).
# AGENT3_SANDBOX_RUNTIME=
# true in production: the executor refuses to start without gVisor.
# AGENT3_REQUIRE_GVISOR=false
# How long a read execution job stays invisible before pgmq redelivers it (queue.py).
# AGENT3_QUEUE_VISIBILITY_TIMEOUT_SECONDS=3600
