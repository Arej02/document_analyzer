# Same Supabase project as the backend's SUPABASE_URL — Project Settings > API.
VITE_SUPABASE_URL=

# Anon/public key — safe to ship to the browser. RLS + the backend's JWT
# validation (design.md §1a) are what enforce access, not this key.
